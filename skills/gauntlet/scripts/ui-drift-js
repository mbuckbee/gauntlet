#!/usr/bin/env node
"use strict";

// UI drift for non-Rails repos (Next.js/React, Astro, plain CSS/CSS Modules).
// Lints the HEAD versions of the UI files a diff changed with the ui-lint
// sidecar (its own ESLint + stylelint config, never the repo's) and keeps only
// the drift the diff introduced. Read-only: files come from `git archive`.
//
//   ui-drift-js [--base origin/main] [--head HEAD] [--repo .]
//
// Prints one JSON document, same shape as ui-drift-rails. Exit 0 always;
// prints {"skipped": "..."} for Rails repos, diffs with no UI files, or a
// missing sidecar. "Introduced" is decided by lib/diff-filter.cjs.

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawnSync } = require("node:child_process");
const { DiffFilter, git, exportFiles } = require("./lib/diff-filter.cjs");

const expandHome = (p) => (p === "~" || p.startsWith("~/") ? path.join(os.homedir(), p.slice(1)) : p);
const SIDECAR = path.resolve(expandHome(process.env.UI_LINT_DIR || path.join(__dirname, "..", "ui-lint")));
const UI_EXT = /\.(?:jsx?|tsx?|astro|vue|svelte|css|scss)$/;
// Not shipped UI: tests, stories, build output, config, tooling scripts.
const SKIP_PATH =
  /(?:^|\/)(?:node_modules|dist|build|out|coverage|vendor|public|\.next|\.astro|tests?|spec|__tests__|__mocks__|e2e|smoke|scripts|\.storybook)\/|\.(?:test|spec|stories|config|min)\.[^/]+$|\.d\.ts$/;
const KEPT = ["check", "file", "line", "snippet", "tier", "char"];

function parseArgs(argv) {
  const opts = { base: "origin/main", head: "HEAD", repo: "." };
  for (let i = 0; i < argv.length; i++) {
    const m = argv[i].match(/^--(base|head|repo)(?:=(.*))?$/);
    if (!m) throw new Error(`unknown argument ${argv[i]}`);
    opts[m[1]] = m[2] ?? argv[++i];
  }
  return opts;
}

function run() {
  const opts = parseArgs(process.argv.slice(2));
  const repo = git(opts.repo, "rev-parse", "--show-toplevel").trim();
  const gemfile = path.join(repo, "Gemfile");
  if (fs.existsSync(gemfile) && /gem ["']rails["']/.test(fs.readFileSync(gemfile, "utf8"))) {
    return { skipped: "Rails repo: use ui-drift-rails" };
  }
  if (!fs.existsSync(path.join(SIDECAR, "node_modules/eslint/package.json"))) {
    return { skipped: `ui-lint sidecar missing: cd ${SIDECAR} && npx npm@11 ci` };
  }

  const range = `${opts.base}...${opts.head}`;
  const changed = git(repo, "diff", "--name-only", "--diff-filter=AMR", range).split("\n");
  const uiFiles = changed.filter((f) => UI_EXT.test(f) && !SKIP_PATH.test(f));
  if (uiFiles.length === 0) return { skipped: "diff touches no UI files", range };

  const diff = new DiffFilter(repo, opts.base, opts.head, uiFiles);
  if (diff.empty) return { skipped: "diff adds no lines to UI files", range };
  const files = diff.addedFiles;

  const notes = [];
  if (files.some((f) => /\.(?:vue|svelte)$/.test(f))) {
    notes.push("no Vue/Svelte template parser: .vue/.svelte files get <style> raw_color checks only");
  }

  const headSha = git(repo, "rev-parse", "--short", opts.head).trim();
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "ui-drift-js-"));
  let lint;
  try {
    exportFiles(repo, opts.head, files, dir);
    const res = spawnSync(process.execPath, [path.join(SIDECAR, "run.mjs"), "--root", dir, ...files], {
      cwd: SIDECAR,
      env: { ...process.env, NODE_NO_WARNINGS: "1" },
      encoding: "utf8",
      maxBuffer: 1024 * 1024 * 1024,
    });
    try {
      lint = JSON.parse(res.stdout);
    } catch {
      const stderr = String(res.stderr || "").split(/(?<=\n)/).slice(-8).join("");
      return { skipped: `ui-lint produced no JSON (exit ${res.status})`, stderr };
    }
  } finally {
    fs.rmSync(dir, { recursive: true, force: true });
  }

  // raw_color carries the literal as `value` (several can share a line).
  const cmp = (a, b) => (a < b ? -1 : a > b ? 1 : 0);
  const findings = diff
    .filter(lint.findings)
    .sort((a, b) => cmp(a.file, b.file) || a.line - b.line || (Number(a.column) || 0) - (Number(b.column) || 0))
    .map((f) => {
      const out = {};
      for (const k of KEPT) if (k in f) out[k] = f[k];
      if (f.check === "raw_color") out.value = f.token;
      return out;
    });

  const result = {
    range,
    head: headSha,
    added_lines: diff.addedRaw.length,
    linted_files: files.length,
    raw_counts: lint.raw_counts,
    introduced: findings.length,
    findings,
  };
  if (lint.parse_errors.length) result.parse_errors = lint.parse_errors;
  if (notes.length) result.notes = notes;
  return result;
}

let output;
try {
  output = run();
} catch (e) {
  output = { skipped: `ui-drift-js failed: ${e.message}` };
}
console.log(JSON.stringify(output, null, 2));
